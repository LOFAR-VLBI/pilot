# Adapted from facetselfcal's create_losoto_flag_ap_only at:
# https://github.com/rvweeren/lofar_facet_selfcal/blob/9441175e3018ba1547ce1b384c4f4bc22970decf/submods/losoto_helpers.py#L1131-L1213
# Detect outliers in XX/YY only; retain the full-Jones values and cross-hands.
soltab = [sol000/*]
pol = [XX,YY]
Ncpu = 4

[flagamp]
soltab = [sol000/amplitude000]
operation = FLAG
axesToFlag = [time,freq]
mode = smooth
maxCycles = 3
windowNoise = 7
maxRms = 7.0
order = [5,5]
replace = False
preflagzeros = False

[flagphase]
soltab = [sol000/phase000]
operation = FLAG
axesToFlag = [time,freq]
mode = smooth
maxCycles = 3
windowNoise = 7
maxRms = 7.0
order = [5,5]
replace = False
preflagzeros = False
